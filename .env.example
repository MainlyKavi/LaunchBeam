# Public application origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth, Postgres, and Storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public waitlist spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public mutation and analytics rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC signing for email confirmation, unsubscribe, and referral cookies.
# Use a random value of at least 32 characters and keep it server-only.
EMAIL_TOKEN_SECRET=
